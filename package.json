{
  "name": "agent-annotator",
  "version": "0.1.1",
  "description": "Universal browser & desktop annotation collector for AI coding agents (Claude Code, Cursor, Codex, Antigravity)",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "bin": {
    "annotator": "./packages/collector-hub/src/cli.js"
  },
  "scripts": {
    "start": "node ./packages/collector-hub/src/cli.js serve",
    "install-service": "node ./packages/collector-hub/src/cli.js install-service",
    "mcp": "node ./packages/collector-hub/src/cli.js mcp",
    "install-mcp": "node ./packages/collector-hub/src/cli.js install-mcp",
    "pack-release": "node ./packages/collector-hub/src/cli.js pack",
    "doctor": "node ./packages/collector-hub/src/cli.js doctor",
    "stats": "node ./packages/collector-hub/src/cli.js stats",
    "benchmark": "node ./packages/collector-hub/src/cli.js benchmark",
    "test": "node --test ./tests/*.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
