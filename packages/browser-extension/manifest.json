{
  "manifest_version": 3,
  "name": "Agent Annotator",
  "version": "0.1.1",
  "description": "Annotate any webpage and hand AI coding agents (Claude Code, Cursor, Codex) a structured prompt with cropped screenshots.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "optional_host_permissions": [],
  "action": {
    "default_title": "Annotate Page for AI Agent (Alt+Shift+A)",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "commands": {
    "toggle-annotation": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Toggle Agent Annotator on current tab"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
